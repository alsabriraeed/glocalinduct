{
  "$defs": {
    "InsightContent": {
      "additionalProperties": false,
      "properties": {
        "lesson": {
          "minLength": 1,
          "title": "Lesson",
          "type": "string"
        },
        "applies_when": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Applies When",
          "type": "array"
        },
        "avoid_when": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Avoid When",
          "type": "array"
        },
        "recommended_strategy": {
          "anyOf": [
            {
              "enum": [
                "retain",
                "substitute"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recommended Strategy"
        },
        "preserve": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Preserve",
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "support_experience_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Support Experience Ids",
          "type": "array"
        },
        "counterevidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Counterevidence Ids",
          "type": "array"
        },
        "origin": {
          "enum": [
            "reference",
            "attempt",
            "mixed"
          ],
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "lesson",
        "applies_when",
        "avoid_when",
        "recommended_strategy",
        "preserve",
        "scope",
        "support_experience_ids",
        "counterevidence_ids",
        "origin"
      ],
      "title": "InsightContent",
      "type": "object"
    },
    "InsightOperation": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        },
        "operation": {
          "enum": [
            "ADD",
            "EDIT",
            "UPVOTE",
            "DOWNVOTE"
          ],
          "title": "Operation",
          "type": "string"
        },
        "target_insight_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Insight Id"
        },
        "expected_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Version"
        },
        "proposed_content": {
          "anyOf": [
            {
              "$ref": "#/$defs/InsightContent"
            },
            {
              "type": "null"
            }
          ]
        },
        "support_experience_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Support Experience Ids",
          "type": "array"
        },
        "counterevidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Counterevidence Ids",
          "type": "array"
        },
        "justification": {
          "minLength": 1,
          "title": "Justification",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "operation",
        "target_insight_id",
        "expected_version",
        "proposed_content",
        "support_experience_ids",
        "counterevidence_ids",
        "justification"
      ],
      "title": "InsightOperation",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "universal",
            "domain",
            "context"
          ],
          "title": "Level",
          "type": "string"
        },
        "domains": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Domains",
          "type": "array"
        },
        "genres": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Genres",
          "type": "array"
        },
        "culture_specific": {
          "title": "Culture Specific",
          "type": "boolean"
        },
        "locale_scope": {
          "enum": [
            "general_arab",
            "specified",
            "unspecified"
          ],
          "title": "Locale Scope",
          "type": "string"
        },
        "locales": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Locales",
          "type": "array"
        },
        "setting": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Setting"
        },
        "time_period": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Time Period"
        },
        "cross_domain_transfer": {
          "title": "Cross Domain Transfer",
          "type": "boolean"
        }
      },
      "required": [
        "level",
        "domains",
        "genres",
        "culture_specific",
        "locale_scope",
        "locales",
        "setting",
        "time_period",
        "cross_domain_transfer"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "comparison_id": {
      "minLength": 1,
      "title": "Comparison Id",
      "type": "string"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/InsightOperation"
      },
      "title": "Operations",
      "type": "array"
    }
  },
  "required": [
    "comparison_id",
    "operations"
  ],
  "title": "InsightUpdateBatchPayload",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
